// Secrets.xcconfig.example — COMMITTED TEMPLATE. Contains NO real values.
//
// TO USE (Owner / whoever holds the credentials):
//   1. cp Config/Secrets.xcconfig.example Config/Secrets.xcconfig
//   2. Paste the real values into Config/Secrets.xcconfig (it is .gitignore'd).
//   3. Rebuild. Config/Instrumentation.xcconfig #include?'s it automatically.
//
// NEVER put real keys/DSNs in THIS file, and NEVER commit Config/Secrets.xcconfig.
//
// ============================================================================
// xcconfig GOTCHA — read before pasting a URL:
// In an .xcconfig file, "//" starts a COMMENT. A raw value like
//     SENTRY_DSN = https://abc@o0.ingest.sentry.io/123
// is silently TRUNCATED at the "//" to "https:". To keep the slashes, break the
// "//" with an empty interpolation "$()", which expands to nothing at build time:
//     SENTRY_DSN = https:/$()/abc@o0.ingest.sentry.io/123
// Do the same for POSTHOG_HOST. (POSTHOG_API_KEY has no "//", paste it as-is.)
// ============================================================================

// PostHog project: "econbyte" (project analytics). Never reuse another Dudley
// app's project — the cross-app identity separation depends on the projects
// being distinct. The key looks like "phc_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX".
POSTHOG_API_KEY =

// PostHog ingest host. Leave EMPTY to use PostHog US cloud
// (https://us.i.posthog.com, applied in code). If you set it, use the "$()"
// escape shown above, e.g.  https:/$()/eu.i.posthog.com
POSTHOG_HOST =

// Sentry project: "econbyte" (crash diagnostics). Use the "$()" escape above:
//   SENTRY_DSN = https:/$()/PUBLICKEY@oORG.ingest.sentry.io/PROJECTID
SENTRY_DSN =
