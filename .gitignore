# Secrets — NEVER commit
.env
.env.*
*.mobileprovision
*.p12
*.cer
*.certSigningRequest

# Instrumentation secrets (PostHog API key/host, Sentry DSN). The gitignored
# Config/Secrets.xcconfig holds the real values; Config/Instrumentation.xcconfig
# (committed, empty defaults) and Config/Secrets.xcconfig.example (committed
# template) are safe to track.
Config/Secrets.xcconfig
Config/Secrets.local.xcconfig

# Xcode / build
DerivedData/
build/
*.xcuserstate
xcuserdata/
*.xcscmblueprint
.DS_Store

# The committed EconByte.xcodeproj uses a synchronized folder group, so new
# files are auto-included — we DO commit the project so the app builds without
# requiring xcodegen on the build machine. Keep only user-state out of git.
EconByte.xcodeproj/xcuserdata/
