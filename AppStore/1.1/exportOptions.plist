<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  EconByte 1.1 (build 6) — App Store export options for plan Task 6b.

  Used with the retained archive:
    xcodebuild -exportArchive \
      -archivePath <retention>/EconByte-1.1-build6.xcarchive \
      -exportOptionsPlist AppStore/1.1/exportOptions.plist \
      -exportPath <export-dir>

  signingStyle is MANUAL on purpose. The archive is development-signed, and
  export is where distribution signing is applied. The provisioningProfiles
  entry below names the profile Task 6b must CREATE first: the profile
  currently on the build host is Xcode-managed and embeds a superseded
  distribution certificate, and an Xcode-managed profile cannot be refreshed
  through the App Store Connect API. See release-packet.json →
  archive.signing.distributionSigningAttemptedAndWhyItFailed and
  sixBHandoff step 1.

  If Task 6b instead takes the owner-led Xcode fallback, switch signingStyle
  to "automatic", delete the provisioningProfiles dictionary, and let Xcode
  resolve signing in an authenticated session.

  No credentials appear in this file. The API key is referenced by key ID and
  issuer ID on the command line, and the .p8 lives outside the repository.
-->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>

	<key>teamID</key>
	<string>Q2DM9FSRL4</string>

	<key>signingStyle</key>
	<string>manual</string>

	<key>signingCertificate</key>
	<string>Apple Distribution</string>

	<key>provisioningProfiles</key>
	<dict>
		<key>com.nsantulli.econbyte</key>
		<string>EconByte App Store 1.1</string>
	</dict>

	<!-- Export only. Uploading is a separate, explicit step so the export can
	     be inspected before anything reaches App Store Connect. -->
	<key>destination</key>
	<string>export</string>

	<key>uploadSymbols</key>
	<true/>

	<!-- The version and build number are set in the project and verified in
	     the archive (1.1 / 6). Nothing may renumber them at export. -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>

	<key>stripSwiftSymbols</key>
	<true/>
</dict>
</plist>
